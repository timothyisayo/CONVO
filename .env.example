# Optional future feature: keep disabled for the published Convo release.
OPEN_NOTEBOOK_VAULT_ENABLED=false
# Required only when re-enabling Convo Vault with a hosted Open Notebook service.
OPEN_NOTEBOOK_URL=
OPEN_NOTEBOOK_PASSWORD=
# Set this to the exact Qwen model configured in Open Notebook.
OPEN_NOTEBOOK_VAULT_QWEN_MODEL=
# A private service-to-service key shared only by Convo and Open Notebook.
OPEN_NOTEBOOK_VAULT_SERVICE_KEY=
# Comma-separated exact HTTPS source hosts allowed for Vault link ingestion.
OPEN_NOTEBOOK_VAULT_SOURCE_ALLOWLIST=

# Open Notebook's own Ollama/embedding configuration is not required by Convo.
